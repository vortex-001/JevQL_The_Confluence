# Django Core Settings
DEBUG=True
SECRET_KEY=jevql-dev-insecure-key-replace-in-production-!@#$987654321
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL 14+)
# Note: Use standard PostgreSQL. Do NOT install or depend on paid extensions like pg-jev.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=jevql_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Optional Semantic Provider (Leave empty for pure structured & FTS search)
GEMINI_API_KEY=
SEMANTIC_PROVIDER=gemini
SEMANTIC_TIMEOUT_SECONDS=5.0
SEMANTIC_CANDIDATE_LIMIT=50
SEMANTIC_SIMILARITY_THRESHOLD=0.45
SEMANTIC_EMBEDDING_MODEL=text-embedding-004